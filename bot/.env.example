# העתיקו ל-.env ומלאו. אל תכניסו את הקובץ הזה ל-git.
#   cp .env.example .env && chmod 600 .env

# RiseUp — טוקן אישי. החליפו את זה שכבר נחשף.
RISEUP_PAT=riseup_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Telegram — מ-@BotFather אחרי /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# לאן לשלוח. מזהה קבוצה (מספר שלילי) או כמה מזהים מופרדים בפסיק.
# מריצים `docker compose run --rm bot whoami` כדי לקבל אותם.
TELEGRAM_CHAT_IDS=

# --- אופציונלי, אלה ברירות המחדל ---
# POLL_SECONDS=1800          # כל חצי שעה
# QUIET_START=22:30          # מכאן לא נשלחות הודעות
# QUIET_END=07:30            # ועד כאן
# DIGEST_AT=20:30            # שעת הסיכום היומי
# MAX_INDIVIDUAL_ALERTS=3    # מעל זה — הודעה מאוחדת אחת
# COMMANDS_ENABLED=1         # מענה ל-/status ו-/month
# PERSONA=1                  # 0 = הודעות יבשות בלי האופי של מוסלם
